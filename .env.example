# Copy to .env (never commit .env)
PARABANK_URL=https://parabank.parasoft.com/parabank
DATA_SEED=42

# Claude API (triage + SOP generation). Leave empty to use the offline heuristic fallback.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Jira Cloud (free plan is fine). Leave empty for dry-run mode (payloads written to results/jira_dryrun/).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BANK

# Set to 1 to include the labelled canary tests that are designed to fail
RUN_CANARIES=0
